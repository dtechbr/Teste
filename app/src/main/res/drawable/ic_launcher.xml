<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient android:startColor="#071826" android:endColor="#0A3550" android:angle="315" />
        </shape>
    </item>
    <item android:left="18dp" android:top="18dp" android:right="18dp" android:bottom="18dp">
        <shape android:shape="oval">
            <solid android:color="#123E5A" />
            <stroke android:width="3dp" android:color="#16D5E3" />
        </shape>
    </item>
</layer-list>
